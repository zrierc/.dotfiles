#!/usr/bin/env bash
# current theme
type="$HOME/.config/rofi/conf"
style="applets-vertical.rasi"
theme="$type/$style"

prompt='Display Orientation'
monitors=$(xrandr | grep -iw "connected" | wc -l)
# monitors=$(xrandr --listactivemonitors | grep -i 'monitor' | cut -d':' -f2);
PRIMARY_DISPLAY="eDP"
SECONDARY_DISPLAY="HDMI-A-0"

# rofi window layout configuration
list_col='1'
list_row='4'
win_width='120px'

# Options
layout=$(cat ${theme} | grep 'USE_ICON' | cut -d'=' -f2)
if [[ "$layout" == 'NO' ]]; then
  pconly="󰌢 PC Screen Only"
  extend="󰌢 󰍹 Extend"
  duplicate="󰍺 Duplicate"
  secondscreen="󰍹 Second Screen Only"
else
  pconly="󰌢 "
  extend="󰌢 󰍹 "
  duplicate="󰍺 "
  secondscreen="󰍹 "
fi

# Rofi CMD
rofi_cmd() {
  rofi -theme-str "window {width: $win_width;}" \
    -theme-str "listview {columns: $list_col; lines: $list_row;}" \
    -theme-str 'element-text {horizontal-align: 0.4;}' \
    -dmenu \
    -p "$prompt" \
    -markup-rows \
    -theme ${theme}
}

# Confirmation menu/modal
confirm_cmd() {
  rofi -dmenu \
    -p "Confirmation" \
    -mesg "Set 2nd monitor as primary display?" \
    -theme "$type/confirm.rasi"
}

confirm_selection() {
  echo -e "$yes\n$no" | confirm_cmd
}

# Pass variables to rofi dmenu
run_rofi() {
  echo -e "$pconly\n$extend\n$duplicate\n$secondscreen" | rofi_cmd
}

# show notification when display changes
show_notification() {
  notify_cmd='dunstify -u low -t 500 --replace=420'
  ${notify_cmd} "$1"
}

# Enhanced notification with resolution info
show_notification_with_res() {
  notify_cmd='dunstify -u low -t 1000 --replace=420'
  ${notify_cmd} "$1"
}

## Helper Function ##
# Function to get the maximum resolution for a display
get_max_resolution() {
  local display="$1"
  xrandr | grep -A 20 "^$display connected" | grep -E '^\s+[0-9]+x[0-9]+' | head -1 | awk '{print $1}'
}

# Function to get preferred resolution (usually the native/maximum resolution)
get_preferred_resolution() {
  local display="$1"
  # Get the preferred resolution (marked with +)
  local preferred=$(xrandr | grep -A 20 "^$display connected" | grep -E '^\s+[0-9]+x[0-9]+.*\+' | head -1 | awk '{print $1}')

  # If no preferred resolution found, get the maximum available
  if [[ -z "$preferred" ]]; then
    preferred=$(get_max_resolution "$display")
  fi

  echo "$preferred"
}

# Get optimal resolutions
PRIMARY_RES=$(get_preferred_resolution "$PRIMARY_DISPLAY")
SECONDARY_RES=$(get_preferred_resolution "$SECONDARY_DISPLAY")

# display mode switcher
run_cmd() {
  if [[ "$1" == '--pconly' ]]; then
    # xrandr --output eDP --primary --auto --output HDMI-A-0 --off
    xrandr --output "$PRIMARY_DISPLAY" --primary --mode "$PRIMARY_RES" --output "$SECONDARY_DISPLAY" --off
  elif [[ "$1" == '--extend' ]]; then
    ans=$(confirm_selection &)
    if [[ $ans == "$yes" ]]; then
      # xrandr --output HDMI-A-0 --primary --auto --rotate normal --left-of eDP --auto
      xrandr --output "$SECONDARY_DISPLAY" --primary --mode "$SECONDARY_RES" --rotate normal \
        --output "$PRIMARY_DISPLAY" --mode "$PRIMARY_RES" --rotate normal --right-of "$SECONDARY_DISPLAY"
    else
      # xrandr --output eDP --primary --auto --output HDMI-A-0 --auto --rotate normal --left-of eDP --auto
      xrandr --output "$PRIMARY_DISPLAY" --primary --mode "$PRIMARY_RES" --rotate normal \
        --output "$SECONDARY_DISPLAY" --mode "$SECONDARY_RES" --rotate normal --left-of "$PRIMARY_DISPLAY"
    fi
  elif [[ "$1" == '--duplicate' ]]; then
    # xrandr --output eDP --primary --auto --output HDMI-A-0 --auto --same-as eDP
    xrandr --output "$PRIMARY_DISPLAY" --primary --mode "$PRIMARY_RES" \
      --output "$SECONDARY_DISPLAY" --mode "$SECONDARY_RES" --scale-from "$PRIMARY_RES" --same-as "$PRIMARY_DISPLAY"
  elif [[ "$1" == '--secondscreen' ]]; then
    # xrandr --output HDMI-A-0 --primary --auto --output eDP --off
    xrandr --output "$SECONDARY_DISPLAY" --primary --mode "$SECONDARY_RES" --output "$PRIMARY_DISPLAY" --off

  fi
}

# check connected monitors
if (($monitors >= 2)); then
  # Ensure valid resolutions before proceeding
  if [[ -z "$SECONDARY_RES" || -z "$PRIMARY_RES" ]]; then
    show_notification " [ERRO] Could not detect display resolutions!"
    exit 1
  fi

  chosen="$(run_rofi)"
  case "$chosen" in
  $pconly)
    run_cmd --pconly
    ;;
  $extend)
    run_cmd --extend
    ;;
  $duplicate)
    run_cmd --duplicate
    ;;
  $secondscreen)
    run_cmd --secondscreen
    ;;
  esac
else
  show_notification " 2nd monitor not connected!"
fi
